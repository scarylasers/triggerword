# Audio assets — large binaries, not source. These stay on disk; git just
# does not track them. Importing soundpacks in the app is unaffected.
sounds/
soundpack/
soundpack_export/
SOUNDPACKS/
*.zip
# ...except the starter pack the app ships with
!TriggerWord-Starter-Pack.zip

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Runtime logs from the hidden server/router (full mode)
triggerword-*.log
launcher.log

# Installer build artifacts (the embedded Python runtime, staged payload and
# compiled setup exe are all reproducible from installer/build.ps1)
installer/build/
installer/dist/

# Editor / OS
.idea/
Thumbs.db
.DS_Store

# Node (added for the node:test suite; no dependencies are installed)
node_modules/
